{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisToComparison",
  "type": "object",
  "required": ["sub_question_id", "findings"],
  "properties": {
    "sub_question_id": {
      "type": "string",
      "enum": ["approaches", "datasets", "architectures", "metrics", "disagreements"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "evidence", "dataset", "approach", "architecture", "metrics", "reported_values", "confidence"],
        "properties": {
          "claim_id": { "type": "string" },
          "claim": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["arxiv_id", "source_text"],
              "properties": {
                "arxiv_id": { "type": "string" },
                "source_text": { "type": "string" }
              }
            }
          },
          "dataset": { "type": ["string", "null"] },
          "approach": { "type": ["string", "null"] },
          "architecture": { "type": ["string", "null"] },
          "metrics": { "type": "array", "items": { "type": "string" } },
          "reported_values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["metric", "value"],
              "properties": {
                "metric": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    }
  },
  "_invariants": [
    "A finding must not contain a numerical result (reported_values) unless the source evidence actually supports that result.",
    "Nullable fields (dataset, approach, architecture) use null, never empty string.",
    "The Comparison agent must copy this claim_id forward into 'source_claim_id' on the Comparison row it produces from this finding — see comparison_to_synthesis.json."
  ]
}
